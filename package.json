{
	"name": "heavy-rig",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": "1.3.14"
	},
	"scripts": {
		"dev": "bun --port ${PORT:-3000} --console index.html",
		"dev:models": "bun --port ${PORT:-3001} --console models-preview.html",
		"build": "bun run scripts/build.ts",
		"preview": "bun run scripts/preview.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"check": "bun run test && bun run typecheck && bun run lint && bun run build",
		"mech:prompt": "bun run scripts/mech-design/cli.ts",
		"mech:builder": "bun run scripts/mech-design/builder.ts"
	},
	"dependencies": {
		"d3-contour": "4.0.3",
		"ecspresso": "0.24.1",
		"lit-html": "3.3.3",
		"three": "0.186.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/bun": "1.4.4",
		"@types/d3-contour": "3.0.6",
		"@types/three": "0.186.0",
		"eslint": "^9.39.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.46.2"
	},
	"description": "Browser mech combat: command a mercenary company, accept faction contracts, and deploy a four-mount combat frame.",
	"homepage": "https://heavyrig.deegeegames.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/DeeGeeGames/heavy-rig.git"
	},
	"bugs": {
		"url": "https://github.com/DeeGeeGames/heavy-rig/issues"
	},
	"author": "DeeGee Games"
}
